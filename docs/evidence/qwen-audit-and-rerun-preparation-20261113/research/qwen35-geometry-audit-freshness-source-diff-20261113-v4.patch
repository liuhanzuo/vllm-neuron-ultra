+    def __init__(self, lock, expected):
+        require(type(expected) is dict and set(expected) == {'path', 'identity'}
+                and type(expected['path']) is str and type(expected['identity']) is dict,
+                'Exact original running ACK observation required')
+        self.lock, self.expected = lock, copy.deepcopy(expected)
+        self.last_full_started = None
+        self.last_clock = None
+
+    def __call__(self, force=False):
+        self.lock.check()
+        require(type(force) is bool, 'Explicit full-freshness boundary')
+        now = time.monotonic()
+        require(type(now) in (float, int) and math.isfinite(now)
+                and (self.last_clock is None or now >= self.last_clock), 'Monotonic freshness clock')
+        self.last_clock = now
+        if force or self.last_full_started is None or now - self.last_full_started >= .5:
+            require(latest_handoff() == self.expected, 'Running binding changed during audit')
+            # Record start, so a slow full scan cannot extend the next interval.
+            self.last_full_started = now
 
 
