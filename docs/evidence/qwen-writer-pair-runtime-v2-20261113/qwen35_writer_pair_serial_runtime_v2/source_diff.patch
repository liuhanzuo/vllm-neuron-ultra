+            re.fullmatch(r'_tp0_bk[0-5]', parts[1]) and
+            re.fullmatch(r'neuronxcc-[A-Za-z0-9_-]{1,64}', parts[2]) and
+            re.fullmatch(r'sg[0-9]{2}', parts[3]) and parts[4] in NAMES,
