+    return {"schema": "qwen35_sampler_api_failure_latch_v1", "phase_spec": phase_ref,
+            "supervisor": owner, "child_bootstrap_owner": child_owner, "marker": marker.decode("ascii"),
+            "observed_monotonic": now, "deadline_monotonic": deadline,
+            "natural_until_monotonic": max(now, deadline - 25),
+            "kill_at_monotonic": max(now, deadline - 10),
+            "log_bytes_at_detection": total_log, "observed_unix_ns": time.time_ns(),
