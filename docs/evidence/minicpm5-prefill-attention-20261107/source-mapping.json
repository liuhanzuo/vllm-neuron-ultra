  "findings": [
    {
      "topic": "QK scaling and output dtype",
      "source_locations": {
        "hf": [
          193,
          215
        ],
        "sdk_attention": [
          532,
          536
        ]
      },
      "observation": "HF uses matmul(Q,K.T) * head_dim**-0.5; SDK uses matmul(Q,K.T) / sqrt(head_dim). Both actual fixture7 unscaled/scaled score captures are BF16, with no source float32 promotion before scaling. Mathematical scale is identical for head_dim128.",
      "existing_capture_checks": [
        "Compare qk0_unscaled then qk0_scaled for each rank over selected query1230 and valid keys0:1231.",
        "Use saved scale_operation provenance for actual Python operator/scalar; do not replace observation with recomputed scores."
      ],
      "limitation": "BF16 output dtype does not establish internal matmul accumulator dtype. Multiply/divide can differ by rounding, but source distinction alone neither proves a mismatch nor explains final KL."
    },
    {
      "topic": "QK reduction and layout",
      "source_locations": {
        "hf": [
          193,
          243,
          245
        ],
        "sdk_attention": [
          532,
          608,
          614
        ],
        "utils": [
          200,
          230
        ]
      },
      "observation": "HF has16 Q heads and2 KV heads; each SDK TP2 rank has8 Q heads and1 KV head, repeating KV8 times in both. QK reduction dimension remains128 per head: there is no cross-rank QK reduction. SDK makes heads contiguous; HF keeps transposed layout. Fixture7 HF length1231 versus SDK padded2048 changes matrix shapes.",
      "existing_capture_checks": [
        "Match full effective K rows, selected Q query and v_heads before interpreting qk0_unscaled.",
        "HF rank head slices [0:8] or [8:16]; SDK local head slice all8."
      ],
      "limitation": "Kernel choice/reduction order may depend on shape/stride; neither a different reduction order nor its numerical effect is established by source alone."
    },
    {
      "topic": "Mask and softmax",
      "source_locations": {
        "hf": [
          194,
          199
        ],
        "sdk_attention": [
          534,
          536,
          888,
          906
        ]
      },
      "observation": "HF adds additive mask; SDK uses bool where with finfo(score.dtype).min. Both call functional.softmax(dim=-1,dtype=float32) then cast to Q.dtype (BF16), followed by BF16 probability/value matmul. Fixture7 metadata independently confirms BF16 softmax input, FP32 probabilities and BF16 probabilities.",
      "existing_capture_checks": [
        "Compare valid-key qk0_scaled\u2192softmax_input\u2192probabilities_fp32\u2192probabilities_bf16.",
        "SDK padded tail [1231:2048] must be audited separately for masking/probability mass; do not compare its min sentinel against nonexistent HF columns."
      ],
      "limitation": "Softmax reduction length1231 versus2048 is a real shape difference even if padding mass is zero. Captures retain only final real query scores; this cannot locate every earlier prompt-query divergence."
    },
    {
      "topic": "Prefill branch and absent extra normalizations",
      "source_locations": {
        "sdk_attention": [
          231,
          247,
          510,
          536,
          738,
          907,
          1330,
          1385
        ],
        "sdk_llama": [
          996,
          1011
        ]
      },
      "observation": "Frozen config logical_nc_config=1,attn_kernel_enabled=null,cp_degree=1 and fixture7 bucket2048 select non-flash prefill. Actual sdk_prefill capture includes scaled_qk/softmax events. qk_layernorm=false; NeuronLlamaAttention does not enable use_qk_norm or learned_sinks.",
      "existing_capture_checks": [
        "Use actual_route/dispatch_flags and real events, not config alone, to confirm capture path."
      ],
      "limitation": "Do not extrapolate this route to bucket4096: source automatically enables unsharded flash there when not explicitly disabled."
    },
    {
      "topic": "Attention value reduction and output projection",
      "source_locations": {
        "hf": [
          199,
          200,
          268,
          269
        ],
        "sdk_attention": [
          2491,
          2497
        ],
        "gqa": [
          1213,
          1223,
          1296,
          1303
        ],
        "parallel": [
          462,
          879,
          997,
          1009,
          1032,
          1051
        ]
      },
      "observation": "HF computes one full-width o_proj over2048 features. SDK computes local1024-feature projection on each TP2 rank via einsum and then sums2048-wide partial outputs. Frozen rpl_reduce_dtype=null is explicitly passed into RowParallelLinear, whose fallback is layer dtype BF16; local output is cast to this dtype before all-reduce and cast back after. Softmax/P@V key reduction length also differs by padding.",
      "existing_capture_checks": [
        "Compare probabilities_bf16 and v_heads to context_before_o at matching real query; then compare context_before_o to attention_output.",
        "For context_before_o compare each SDK1024 block against HF rank*1024:(rank+1)*1024. For attention_output compare entire2048 vectors because SDK is already reduced."
      ],
      "limitation": "The88 capture does not save local o_proj pre-all-reduce output, so it cannot separate local dot-product rounding from collective rounding. Setting only reduce_dtype=float32 cannot recover precision already lost in local BF16 outputs; with just2 ranks, wider addition may even downcast to the same result. No fix or cause is established."
    },
    {
      "topic": "RMSNorm",
      "source_locations": {
        "hf": [
          61,
          66
        ],
        "sdk_cpu_rmsnorm": [
          62,
          67
        ],
        "sdk_llama": [
          136,
          147
        ],
        "custom_rmsnorm": [
          28,
          41
        ]
      },
      "observation": "Official HF and CPU SDK RMSNorm implement the same FP32 mean(x\u00b2), FP32 rsqrt(x\u00b2+eps), cast normalized value to original dtype, then gamma multiply; eps is1e-6. Device SDK routes through CustomRMSNorm: input promoted FP32, RmsNorm.apply with gamma, final cast.",
      "existing_capture_checks": [
        "Existing normalized_input is after input RMSNorm and is exact over all1231 real tokens for fixture7 both ranks/arms.",
        "213-stage saved boundaries include input_layernorm and post_attention_layernorm across42 layers."
      ],
      "limitation": "No explicit variance/rsqrt/pre-gamma intermediate is in88 capture. Device internal RmsNorm accumulator/order is not inferred from wrapper. CPU SDK also fails fixture7, so device-only custom norm cannot by itself explain the shared CPU discrepancy."
    },
    {
      "topic": "Residual and MiniCPM scaling",
      "source_locations": {
        "hf": [
          294,
          312
        ],
        "sdk_llama": [
          1213,
          1223,
          1243,
          1297
        ]
      },
      "observation": "Both active official Llama paths apply residual + attention_output, post-attention RMSNorm, MLP, residual + MLP output. Frozen qkv/mlp kernel and residual fusion flags are false. Official MiniCPM5-2B config identifies LlamaForCausalLM and contains no scale_depth,dim_model_base or scale_emb; neither path applies old MiniCPM residual-depth scaling.",
      "existing_capture_checks": [
        "attention_output is before first residual add. Saved213 boundaries provide layers.N.self_attn, post_attention_layernorm, mlp and full layer output."
      ],
      "limitation": "The standalone post-attention residual sum is not captured by88; post_attention_layernorm combines residual addition and normalization, so divergence there cannot isolate either operator. Do not add MiniCPM-old scaling unsupported by this model config."
    }
  ],
