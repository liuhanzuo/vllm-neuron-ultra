+def virtual_file_offset(loads, address, length):
+    """Map one bounded virtual range to unique, continuous file-backed bytes.
+
+    Each interval must belong to exactly one LOAD's file bytes. Adjacent LOADs
+    may jointly cover the range only when their file offsets are continuous.
+    Holes, overlapping providers, BSS-only bytes and discontinuities fail closed.
+    Program-header/file bounds are checked by parse_elf64 before this helper.
+    """
+    end = address + length
+    cuts = {address, end}
+    for start, _, count in loads:
+        if start < end and address < start + count:
+            cuts.update((max(address, start), min(end, start + count)))
+    ordered = sorted(cuts)
+    first = None
+    for low, high in zip(ordered, ordered[1:]):
+        matches = [base + low - start for start, base, count in loads
+                   if start <= low and high <= start + count]
+        require(len(matches) == 1,
+                "STRTAB interval maps uniquely to file-backed LOAD bytes")
+        offset = matches[0]
+        if first is None:
+            first = offset
+        require(offset == first + low - address,
+                "Adjacent STRTAB LOAD intervals have continuous file offsets")
+    require(first is not None, "Nonempty file-backed STRTAB range")
+    return first
+
 
